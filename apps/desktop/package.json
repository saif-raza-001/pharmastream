{
  "name": "pharmastream-desktop",
  "version": "1.0.0",
  "description": "PharmaStream ERP Desktop Application",
  "main": "main.js",
  "author": "MD Saif Raza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saif-raza-001/pharmastream.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:store": "electron-builder --win appx --x64",
    "build:both": "electron-builder --win nsis appx --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.pharmastream.erp",
    "productName": "PharmaStream",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server/dist",
        "filter": ["**/*"]
      },
      {
        "from": "prisma-build/node_modules",
        "to": "server/node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../web/out",
        "to": "web",
        "filter": ["**/*"]
      },
      {
        "from": "data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "appx",
          "arch": ["x64"]
        }
      ],
      "icon": "icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PharmaStream"
    },
    "appx": {
      "identityName": "MdSaifRaza.PharmaStream",
      "displayName": "PharmaStream - Pharmacy Management",
      "publisherDisplayName": "Md Saif Raza",
      "publisher": "CN=E62814AA-8BD7-41F8-B526-6DEEC493418C",
      "applicationId": "PharmaStreamERP",
      "backgroundColor": "#1e40af",
      "languages": ["en-US", "en-IN"],
      "showNameOnTiles": true,
      "setBuildNumber": true
    },
    "mac": {
      "icon": "icons/mac/icon.icns"
    }
  }
}
